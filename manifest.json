{
  "manifest_version": 3,
  "name": "Egodact Addon: Chat Arcade",
  "version": "0.2.0",
  "description": "Boter-kaas-en-eieren and Connect 4 for Egodact, with streaks, a daily goal, score sharing and online multiplayer.",
  "content_scripts": [
    {
      "matches": ["https://app.egodact.com/*"],
      "js": [
        "vendor/firebase-app-compat.js",
        "vendor/firebase-auth-compat.js",
        "vendor/firebase-firestore-compat.js",
        "sdk.js",
        "lib.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage"]
}